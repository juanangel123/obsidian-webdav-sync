{
  "name": "webdav-vault-sync",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --outfile main.js --format cjs --target browser --external obsidian",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "decrypt": "bun scripts/decrypt.ts",
    "version": "bun scripts/version.ts",
    "e2e": "bun run build && bun tests/obsidian/e2e.ts",
    "mcp": "bun mcp/main.ts",
    "mcp:build": "bun build mcp/main.ts --target=bun --minify --outfile dist/notes-mcp.js"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
